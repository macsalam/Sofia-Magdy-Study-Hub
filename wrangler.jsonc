{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sofia-magdy-study-hub",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sofia-magdy-study-hub",
      "database_id": "0521d624-74eb-41a7-a83b-3e87f9435e9c"
    }
  ]
}
